# Competitor Intelligence Monitor Environment Variables
# Author: Lagana Flow

# Supabase Settings (Optional, can also use supabase-thiago MCP directly)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Proxy Configuration (Optional, for rotating residential proxies if needed at scale)
HTTP_PROXY=
HTTPS_PROXY=

# App Security Settings
ISOLATED_MODE=true
RATE_LIMIT_DELAY_SECONDS=5.0
